# Copy to .env and fill in. Never commit the real .env.
# Every value is optional unless the step that uses it is run.

# Research (tools/research_perplexity.py). Missing key -> exit code 3 -> manual research fallback.
PERPLEXITY_API_KEY=

# Illustrations (tools/generate_images.py). Cloudflare is preferred when its token is set.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GEMINI_API_KEY=

# Gmail sending (tools/send_gmail.py). Not needed for --dry-run.
GMAIL_SENDER_NAME=
# Sends refuse unless the OAuth token authenticates as this account.
EXPECTED_SENDER=
