{# Web archive rendering of a newsletter issue.

   Deliberately NOT the email template: no tables, no inlined CSS, no 600px
   cage. This is the "view in browser" version, so it gets real typography,
   full-resolution art, and both themes.

   Emitted as artifact-ready page content -- no doctype/html/head/body wrapper,
   since the Artifact publish step supplies those. #}
<title>{{ subject }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
<style>
  /* Complete light palette on bare :root -- every token is defined here first
     so the un-stamped "system" state always resolves to a full set. */
  :root {
    --ground: #f2f0ec;
    --surface: #fdfcfa;
    --ink: #14130f;
    --ink-soft: #45423b;
    --ink-muted: #6f6b62;
    --rule: #dcd8cf;
    --rule-soft: #e8e5dd;
    --accent: #1f5fb0;
    --accent-warm: #b8501c;
    --figure-ground: #f7f5f1;
    --shadow: 0 1px 2px rgba(20, 19, 15, .05), 0 10px 30px rgba(20, 19, 15, .06);

    --measure: 40rem;
    --figure-width: 47.5rem;
    --font-display: "Fraunces", Georgia, "Times New Roman", serif;
    --font-body: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* System dark -- unless the viewer explicitly chose light. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #12110e;
      --surface: #1b1a16;
      --ink: #f1efe9;
      --ink-soft: #c8c4ba;
      --ink-muted: #928e84;
      --rule: #34322b;
      --rule-soft: #262521;
      --accent: #7db0ef;
      --accent-warm: #e8895a;
      --figure-ground: #211f1a;
      --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 10px 30px rgba(0, 0, 0, .35);
    }
  }

  /* Explicit dark choice wins over a light OS. */
  :root[data-theme="dark"] {
    --ground: #12110e;
    --surface: #1b1a16;
    --ink: #f1efe9;
    --ink-soft: #c8c4ba;
    --ink-muted: #928e84;
    --rule: #34322b;
    --rule-soft: #262521;
    --accent: #7db0ef;
    --accent-warm: #e8895a;
    --figure-ground: #211f1a;
    --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 10px 30px rgba(0, 0, 0, .35);
  }

  *, *::before, *::after { box-sizing: border-box; }

  body {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    padding-inline: 1.25rem;
    padding-block: 0;
  }

  .issue {
    max-width: var(--figure-width);
    margin-inline: auto;
    padding-block: 3.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* The reading column sits narrower than figures, which break out to the
     full wrapper width. */
  .column { max-width: var(--measure); width: 100%; }

  /* ---- Masthead ---- */
  .masthead {
    display: flex;
    flex-direction: column;
    gap: .875rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .dateline {
    margin: 0;
    font-family: var(--font-mono);
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    gap: .5rem .875rem;
  }

  .dateline .sep { color: var(--rule); }

  .masthead h1 {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: clamp(2.125rem, 6vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -.02em;
    text-wrap: balance;
    color: var(--ink);
  }

  .standfirst {
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  /* ---- Figures ---- */
  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: .625rem;
  }

  figure img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 3px;
    background: var(--figure-ground);
  }

  /* The hero is the only element that gets lift -- everything else stays flat
     so the hierarchy reads. */
  .hero img {
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Section art is cropped to a consistent ratio: the image model returns
     whatever proportions it likes, and an unconstrained portrait crop would
     otherwise swamp the copy it illustrates. */
  .section-art img {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: .75rem;
    line-height: 1.5;
    color: var(--ink-muted);
    padding-left: .75rem;
    border-left: 2px solid var(--rule);
  }

  /* Charts carry real numbers, so they sit on a plain surface with a hairline
     rather than being styled like art. */
  .chart img {
    background: var(--surface);
    border: 1px solid var(--rule-soft);
    padding: .5rem;
  }

  /* ---- Body copy ---- */
  .intro {
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .intro p:first-child::first-letter {
    float: left;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 3.5em;
    line-height: .82;
    padding: .06em .09em 0 0;
    color: var(--accent-warm);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section h2 {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: clamp(1.5rem, 3.2vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -.012em;
    text-wrap: balance;
    color: var(--ink);
  }

  .prose { color: var(--ink); }
  .prose > :first-child { margin-top: 0; }
  .prose > :last-child { margin-bottom: 0; }
  .prose p { margin: 0 0 1rem; text-wrap: pretty; }
  .prose ul, .prose ol { margin: 0 0 1rem; padding-left: 1.25rem; }
  .prose li { margin-bottom: .4rem; }
  .prose strong { font-weight: 600; }
  .prose a { color: var(--accent); text-underline-offset: .16em; }
  .prose table { border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .prose td, .prose th { border-bottom: 1px solid var(--rule-soft); padding: .4rem .75rem .4rem 0; }

  /* Anything that can outgrow the measure scrolls in its own container so the
     page body never scrolls sideways. */
  .prose .scroll-x, .prose pre { overflow-x: auto; }

  hr.divider {
    width: 100%;
    height: 1px;
    border: 0;
    background: var(--rule);
    margin: 0;
  }

  /* ---- Sources ---- */
  .sources-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .sources-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Numbered because these are references the copy points at -- the numbering
     carries information, it isn't ornament. */
  .sources {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: src;
    display: flex;
    flex-direction: column;
    gap: .625rem;
  }

  .sources li {
    counter-increment: src;
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    gap: .25rem;
    font-size: .9375rem;
    line-height: 1.45;
  }

  .sources li::before {
    content: counter(src, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: .75rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .sources a {
    color: var(--accent);
    text-decoration: none;
    text-underline-offset: .16em;
  }

  .sources a:hover { text-decoration: underline; }
  .sources .host {
    display: block;
    font-family: var(--font-mono);
    font-size: .6875rem;
    color: var(--ink-muted);
    margin-top: .1rem;
  }

  .colophon {
    font-family: var(--font-mono);
    font-size: .6875rem;
    line-height: 1.6;
    color: var(--ink-muted);
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule-soft);
  }

  a:focus-visible, :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: .01ms !important;
      transition-duration: .01ms !important;
    }
  }

  @media (max-width: 34rem) {
    .issue { padding-block: 2.25rem 3rem; gap: 2rem; }
    .intro p:first-child::first-letter { font-size: 3em; }
    .sources li { grid-template-columns: 1.6rem 1fr; }
  }
</style>

<article class="issue">
  <header class="masthead column">
    <p class="dateline">
      <span>{{ dateline }}</span>
      {%- if source_count %}
      <span class="sep" aria-hidden="true">/</span>
      <span>{{ source_count }} source{{ '' if source_count == 1 else 's' }}</span>
      {%- endif %}
      {%- if reading_time %}
      <span class="sep" aria-hidden="true">/</span>
      <span>{{ reading_time }} min read</span>
      {%- endif %}
    </p>
    <h1>{{ subject }}</h1>
    {% if preheader %}<p class="standfirst">{{ preheader }}</p>{% endif %}
  </header>

  {% if hero %}
  <figure class="hero">
    <img src="{{ hero.src }}" alt="{{ hero.alt }}">
  </figure>
  {% endif %}

  {% if intro %}
  <div class="intro column">{{ intro_html | safe }}</div>
  {% endif %}

  {% for section in sections %}
  <section class="section">
    <h2 class="column">{{ section.heading }}</h2>
    <div class="prose column">{{ section.body_html | safe }}</div>

    {% if section.image %}
    <figure class="section-art">
      <img src="{{ section.image.src }}" alt="{{ section.image.alt }}">
    </figure>
    {% endif %}

    {# No figcaption: generate_charts.py draws the title into the PNG itself,
       so repeating it here just prints the same line twice. #}
    {% if section.chart %}
    <figure class="chart">
      <img src="{{ section.chart.src }}" alt="{{ section.chart.alt }}">
    </figure>
    {% endif %}
  </section>
  {% if not loop.last %}<hr class="divider">{% endif %}
  {% endfor %}

  {% if sources %}
  <div class="sources-block column">
    <h2 class="sources-title">Sources</h2>
    <ol class="sources">
      {% for source in sources %}
      <li>
        <span>
          <a href="{{ source.url }}" rel="noopener noreferrer" target="_blank">{{ source.title }}</a>
          {% if source.host %}<span class="host">{{ source.host }}</span>{% endif %}
        </span>
      </li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  <p class="colophon column">
    Researched, written and illustrated with an automated pipeline. Charts are
    plotted from the cited figures; illustrations are AI-generated and carry no data.
  </p>
</article>
